 );
 select *from Product Limit 5;
 
 select distinct address from Product ;
  select distinct discount from Product ;

select *from Product order by discount;
select *from Product order by discount desc;
select *from Product order by name;
select *from Product order by odate;
 select * from Product;
 select id,name from Product where discount>=10;
 select *from Product order by address;
 ALTER TABLE Product add column test varchar(50);
alter table Product  drop column test;
 show desc  from  Product;
 
 select id,name from Product group by address;
